APP_NAME="CharyMeld Adverts"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN
APP_DEBUG=false
APP_URL=https://charymeld-adverts.teamodigitalsolutions.com
APP_DOMAIN=charymeld-adverts.teamodigitalsolutions.com

# Force HTTPS (Set to true in production)
FORCE_HTTPS=true
APP_FORCE_HTTPS=true

# Database (fill in from Hostinger hPanel → MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Cache & Session (use file if Redis not available on shared hosting)
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Redis Configuration (leave as-is if not using Redis)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (Hostinger SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@teamodigitalsolutions.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@teamodigitalsolutions.com"
MAIL_FROM_NAME="${APP_NAME}"

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxx
PAYSTACK_WEBHOOK_URL=https://charymeld-adverts.teamodigitalsolutions.com/webhook/paystack

# Flutterwave Configuration
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxx
FLUTTERWAVE_SECRET_HASH=your_webhook_secret_hash
FLUTTERWAVE_WEBHOOK_URL=https://charymeld-adverts.teamodigitalsolutions.com/webhook/flutterwave

# Publisher Platform Settings
PUBLISHER_REVENUE_SHARE=70
PUBLISHER_MIN_PAYOUT=5000

# Security
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_ENCRYPT=false

# SEO & Search Engine Verification
# Get these from Google Search Console and Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SEO_ALLOW_INDEXING=true

# Social Media
TWITTER_HANDLE=@charymeld
FACEBOOK_APP_ID=
